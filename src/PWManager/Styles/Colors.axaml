<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="CanvasBrush" Color="#0B1020"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#111827"/>
  <SolidColorBrush x:Key="RaisedBrush" Color="#172033"/>
  <SolidColorBrush x:Key="LineBrush" Color="#2B3750"/>
  <SolidColorBrush x:Key="TextBrush" Color="#F3F4F6"/>
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A7B0C4"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#6D28D9"/>
  <SolidColorBrush x:Key="FocusBrush" Color="#A78BFA"/>
  <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#262044"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#FB7185"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
  <Thickness x:Key="PagePadding">24</Thickness>
  <CornerRadius x:Key="ControlRadius">8</CornerRadius>
  <CornerRadius x:Key="PanelRadius">12</CornerRadius>
</ResourceDictionary>
