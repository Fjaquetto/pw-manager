<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="CanvasBrush" Color="#090A0B"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#111315"/>
  <SolidColorBrush x:Key="RaisedBrush" Color="#1B1F21"/>
  <SolidColorBrush x:Key="LineBrush" Color="#2A3033"/>
  <SolidColorBrush x:Key="TextBrush" Color="#E8ECEB"/>
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A6B1AD"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#0F766E"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#0D655F"/>
  <SolidColorBrush x:Key="FocusBrush" Color="#7DD3C0"/>
  <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#102B28"/>
  <SolidColorBrush x:Key="ModalOverlayBrush" Color="#B3090A0B"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#FB7185"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
  <Thickness x:Key="PagePadding">24</Thickness>
  <CornerRadius x:Key="ControlRadius">8</CornerRadius>
  <CornerRadius x:Key="PanelRadius">12</CornerRadius>
</ResourceDictionary>
