<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PWManager.ViewModels" xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PWManager.Views.PasswordGeneratorView" x:DataType="vm:MainViewModel">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="8">
        <TextBlock Text="Password generator" Classes="heading"/>
        <TextBlock Text="A fresh password, made for you." Classes="secondary"/>
      </StackPanel>
      <Button Grid.Column="1" Classes="ghost icon" Command="{Binding CloseGeneratorCommand}" AutomationProperties.Name="Close generator">
        <material:MaterialIcon Kind="Close" Width="20" Height="20"/>
      </Button>
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="20">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="GeneratedPassword" Text="{Binding Generator.GeneratedPassword, Mode=OneWay}"
                   PasswordChar="{Binding Generator.PasswordMask}" Classes="secret" IsReadOnly="True" AutomationProperties.Name="Generated password"/>
          <Button Grid.Column="1" Classes="ghost icon" Command="{Binding Generator.TogglePasswordVisibilityCommand}"
                  AutomationProperties.Name="{Binding Generator.VisibilityLabel}" ToolTip.Tip="{Binding Generator.VisibilityLabel}">
            <Grid><material:MaterialIcon Kind="EyeOutline" Width="18" Height="18" IsVisible="{Binding !Generator.IsPasswordVisible}"/><material:MaterialIcon Kind="EyeOffOutline" Width="18" Height="18" IsVisible="{Binding Generator.IsPasswordVisible}"/></Grid>
          </Button>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
          <TextBlock Text="Estimated strength" Classes="caption"/>
          <TextBlock Grid.Column="1" Text="{Binding Generator.StrengthLabel}" FontSize="12" Classes="strength"
                     Classes.weak="{Binding Generator.IsWeak}" Classes.fair="{Binding Generator.IsFair}"/>
          <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding Generator.StrengthValue}" Maximum="100" Height="4"
                       Classes="strength" Classes.weak="{Binding Generator.IsWeak}" Classes.fair="{Binding Generator.IsFair}"/>
        </Grid>
        <Grid ColumnDefinitions="*,140" RowDefinitions="Auto,Auto" RowSpacing="12">
          <TextBlock Text="Length" VerticalAlignment="Center" FontWeight="Medium"/>
          <NumericUpDown Grid.Column="1" Minimum="8" Maximum="48" Increment="1" FormatString="0"
                         Value="{Binding Generator.Length}" AutomationProperties.Name="Password length"/>
          <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="8" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding Generator.Length}" AutomationProperties.Name="Password length slider"/>
        </Grid>
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
          <CheckBox Content="Uppercase (A–Z)" IsChecked="{Binding Generator.UseUppercase}"/>
          <CheckBox Grid.Column="1" Content="Lowercase (a–z)" IsChecked="{Binding Generator.UseLowercase}"/>
          <CheckBox Grid.Row="1" Content="Numbers (0–9)" IsChecked="{Binding Generator.UseNumbers}"/>
          <CheckBox Grid.Row="1" Grid.Column="1" Content="Symbols (!@#)" IsChecked="{Binding Generator.UseSymbols}"/>
        </Grid>
        <TextBlock IsVisible="{Binding Generator.UsesFallback}" Text="No options selected: lowercase letters are used."
                   Classes="caption" TextWrapping="Wrap"/>
        <Button x:Name="GeneratePassword" Content="Generate again" Command="{Binding Generator.GenerateCommand}" HorizontalAlignment="Left"/>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
      <Button Content="Copy password" Command="{Binding CopyGeneratedCommand}"/>
      <Button Grid.Column="2" Content="{Binding GeneratorUseLabel}" Classes="primary" Command="{Binding UseGeneratedPasswordCommand}"/>
    </Grid>
  </Grid>
</UserControl>
